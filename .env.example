# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase PostgreSQL (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (session mode, port 5432) — used for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# AWS (for Bedrock AI)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AlayaCare API (mock-alaya)
ALAYACARE_API_URL=https://mock-alaya.vercel.app
ALAYACARE_PUBLIC_KEY=mock_public_key_123
ALAYACARE_PRIVATE_KEY=mock_private_key_456

# Webhook Authentication (must match mock-alaya's ROSTERA_WEBHOOK_SECRET)
ALAYACARE_WEBHOOK_SECRET=dev-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
