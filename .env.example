# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase PostgreSQL (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (session mode, port 5432) — used for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ElevenLabs — Conversational AI agent + TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# LiveAvatar — Streaming avatar (lip-synced video)
LIVEAVATAR_API_KEY=
# Set avatar ID to enable avatar mode. Leave empty for audio-only.
NEXT_PUBLIC_LIVEAVATAR_AVATAR_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
