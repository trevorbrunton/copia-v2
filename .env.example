# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase PostgreSQL (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (session mode, port 5432) — used for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ElevenLabs — STT for the investor demo (server-side)
ELEVENLABS_API_KEY=
# Voice ID is unused at runtime today; kept for any future TTS use.
ELEVENLABS_VOICE_ID=

# Anthropic — Claude Haiku question classifier for the investor demo
ANTHROPIC_API_KEY=
# Optional: override default model claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ID=

# Tavus CVI — streaming avatar (only required when NEXT_PUBLIC_AVATAR_MODE=tavus)
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# Demo mode — "tavus" (Tavus CVI streaming avatar) or "haiku" (pre-recorded video responses)
NEXT_PUBLIC_AVATAR_MODE=haiku
# Voice activity detection silence timeout in ms (default 1000)
NEXT_PUBLIC_VAD_SILENCE_TIMEOUT_MS=1000
# Optional CDN base for demo audio/video assets. Empty = served from /public.
NEXT_PUBLIC_MEDIA_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
