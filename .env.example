# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase PostgreSQL (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (session mode, port 5432) — used for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ElevenLabs — used for STT in the voice loop (POST /api/v1/screen/process).
# A separate copy of this key is also stored on the Tavus persona's TTS
# layer (set via PATCH /v2/personas/<id> when configuring the persona);
# Tavus uses that copy server-side to render Pep's voice in our chosen
# ElevenLabs voice. See docs/TAVUS-PERSONA-SETUP.md.
ELEVENLABS_API_KEY=
# ElevenLabs voice id (e.g. a Voice Lab clone). Used by the persona-setup
# script; not read at runtime — Tavus's persona config holds the active
# voice id.
ELEVENLABS_VOICE_ID=

# Anthropic — Claude Haiku question classifier for the investor demo
ANTHROPIC_API_KEY=
# Optional: override default model claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ID=

# Tavus CVI — streaming avatar for the screening demo
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
# Single Pep persona id. MUST be `pipeline_mode: "echo"` so the replica
# is a pure rendering layer (no autonomous LLM). See
# docs/TAVUS-PERSONA-SETUP.md to create one with
# `bun scripts/create-tavus-echo-persona.ts`.
NEXT_PUBLIC_TAVUS_PERSONA_ID=

# Voice activity detection silence timeout in ms (default 1000)
NEXT_PUBLIC_VAD_SILENCE_TIMEOUT_MS=1000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
